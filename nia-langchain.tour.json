  "steps": [
    {
      "id": "step-1-overview",
      "title": "Project Overview",
      "description": "Welcome to nia-langchain — a monorepo providing LangChain integrations for Nia AI. The project ships two packages with full feature parity: a Python package (langchain-nia) and a TypeScript package (@nozomioai/langchain-nia). Both expose 20 tools organized into 5 categories that let LangChain agents search code, manage sources, query GitHub, share context, and analyze dependencies.",
      "estimatedTime": 60,
      "colorMode": "fileTypes"
    },
    {
      "id": "step-2-monorepo-layout",
      "title": "Monorepo Structure",
      "description": "The libs/ directory houses both packages side by side. This dual-implementation pattern ensures Python and TypeScript developers get the same capabilities. The root contains shared configuration while each package manages its own build system, dependencies, and tests independently.",
      "estimatedTime": 60,
      "focusDirectory": "libs",
