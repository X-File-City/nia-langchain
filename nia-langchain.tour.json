{
  "id": "nia-langchain-onboarding",
  "title": "Nia LangChain Integration Tour",
  "description": "Explore the dual Python/TypeScript LangChain integration for Nia AI — 20 tools for code search, source management, GitHub access, and knowledge sharing",
  "version": "1.0.0",
  "audience": "New Contributors & Integrators",
  "prerequisites": [
    "Basic familiarity with LangChain concepts (tools, agents, toolkits)",
    "Python or TypeScript experience"
