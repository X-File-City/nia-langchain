    {
      "id": "step-6-build-and-config",
      "title": "Build Systems & Configuration",
      "description": "Each package uses idiomatic build tooling. The Python package uses Hatchling with pyproject.toml for metadata, ruff for linting, mypy for type checking, and uv for dependency management. The TypeScript package uses tsup for bundling, vitest for testing, eslint for linting, and prettier for formatting. Both packages define their own test suites — Python uses pytest with respx for HTTP mocking, TypeScript uses vitest.",
      "estimatedTime": 90,
      "focusDirectory": "libs",
